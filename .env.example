#Database
POSTGRES_DB=conduit_database
POSTGRES_USER=myuser
POSTGRES_PASSWORD=changeme

#Django
SECRET_KEY_DB='mysecretkey'
DEBUG_VALUE="True"
DJANGO_PORT=8000
# Requests reach Django through the frontend's nginx reverse proxy (see
# conduit-frontend/nginx.conf), so this must list the host the *browser*
# uses to reach the frontend - not the backend's own address.
ALLOWED_HOSTS_DB=conduit-backend,localhost

